OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"
POLYGON_API_KEY=

# Dev (docker-compose.yml) uses Postgres. The Pi production stack
# (docker-compose.prod.yml) overrides this with SQLite — leave this as-is.
DATABASE_URL=postgresql+psycopg://greenblatt:greenblatt@db:5432/greenblatt

SCAN_LOOKBACK_DAYS=30
SCAN_CRON_HOUR=21
SCAN_CRON_MINUTE=15

OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini

# --- Production / Raspberry Pi only (see DEPLOY.md) -------------------------
# The address the BROWSER uses to reach the backend. Must be the Pi's LAN host
# (its IP or raspberrypi.local), NOT localhost — it's baked into the frontend
# at build time. Used by docker-compose.prod.yml's frontend build arg.
NEXT_PUBLIC_API_BASE=http://raspberrypi.local:8000
