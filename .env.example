OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"
POLYGON_API_KEY=

# Dev (docker-compose.yml) uses Postgres. The native / Pi deployment uses SQLite
# with an absolute path, e.g.:
#   DATABASE_URL=sqlite:////home/you/special-situations/data/greenblatt.db
DATABASE_URL=postgresql+psycopg://greenblatt:greenblatt@db:5432/greenblatt

SCAN_LOOKBACK_DAYS=30
SCAN_CRON_HOUR=21
SCAN_CRON_MINUTE=15

OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
