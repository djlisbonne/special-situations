OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_ORGANIZATION=

SEC_EDGAR_USER_AGENT="Your Name your.email@example.com"
POLYGON_API_KEY=

# SQLite by default. Unset, the app uses ./data/greenblatt.db relative to the
# working directory (backend/). On the Pi, prefer an absolute path (note the
# FOUR slashes), e.g.:
#   DATABASE_URL=sqlite:////home/you/special-situations/data/greenblatt.db
#DATABASE_URL=sqlite:///./data/greenblatt.db

SCAN_LOOKBACK_DAYS=30
SCAN_CRON_HOUR=21
SCAN_CRON_MINUTE=15

OPENAI_MODEL_PRIMARY=gpt-4o
OPENAI_MODEL_FAST=gpt-4o-mini
